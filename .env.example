DEFAULT_MODEL=ollama

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name_here

JWT_SECRET="your_jwt_secret_key_here"










